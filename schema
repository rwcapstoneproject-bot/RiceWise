USE `ricewise_db`;

ALTER TABLE `calendar_events`
  ADD COLUMN `event_time` TIME NOT NULL DEFAULT '08:00:00' AFTER `event_date`,
  ADD COLUMN `category` ENUM('planting','harvest','irrigation','pest','fertilize','other')
              NOT NULL DEFAULT 'other' AFTER `description`,
  ADD COLUMN `reminder_type` ENUM('same-day','1-day','1-week')
              NOT NULL DEFAULT 'same-day' AFTER `category`;

UPDATE `calendar_events` SET `category` = 'fertilize', `color` = '#7b5ea7' WHERE `title` LIKE '%fertilizer%';
UPDATE `calendar_events` SET `category` = 'pest',       `color` = '#c0392b' WHERE `title` LIKE '%stem borer%' OR `title` LIKE '%pest%';
UPDATE `calendar_events` SET `category` = 'other',      `color` = '#5a7a52' WHERE `title` LIKE '%seed%';
UPDATE `calendar_events` SET `category` = 'harvest',    `color` = '#c8963e' WHERE `title` LIKE '%harvest%';





