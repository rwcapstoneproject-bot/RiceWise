USE `ricewise_db`;

CREATE TABLE IF NOT EXISTS `planting_cycles` (
  `id`             INT(11)       NOT NULL AUTO_INCREMENT,
  `user_id`        INT(11)       NOT NULL,
  `field_location` VARCHAR(150)  NOT NULL COLLATE utf8mb4_general_ci,
  `crop_type`      VARCHAR(50)   DEFAULT NULL COLLATE utf8mb4_general_ci,
  `start_date`     DATE          NOT NULL,
  `status`         ENUM('active','completed') NOT NULL DEFAULT 'active' COLLATE utf8mb4_general_ci,
  `completed_at`   TIMESTAMP     NULL DEFAULT NULL,
  `created_at`     TIMESTAMP     NOT NULL DEFAULT CURRENT_TIMESTAMP,
  PRIMARY KEY (`id`),
  KEY `user_id` (`user_id`),
  KEY `user_status` (`user_id`, `status`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci;

CREATE TABLE IF NOT EXISTS `planting_process_completed` (
  `id`            INT(11)   NOT NULL AUTO_INCREMENT,
  `user_id`       INT(11)   NOT NULL,
  `cycle_id`      INT(11)   NOT NULL,
  `step_index`    TINYINT   NOT NULL,
  `completed_at`  TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
  PRIMARY KEY (`id`),
  UNIQUE KEY `cycle_step` (`cycle_id`, `step_index`),
  KEY `user_id` (`user_id`),
  KEY `cycle_id` (`cycle_id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci;






