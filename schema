CREATE TABLE IF NOT EXISTS `farm_records` (
  `id`          INT(11)       NOT NULL AUTO_INCREMENT,
  `user_id`     INT(11)       NOT NULL,
  `activity`    VARCHAR(100)  NOT NULL COLLATE utf8mb4_general_ci,
  `crop_type`   VARCHAR(50)   DEFAULT NULL COLLATE utf8mb4_general_ci,
  `location`    VARCHAR(150)  DEFAULT NULL COLLATE utf8mb4_general_ci,
  `quantity`    DECIMAL(10,2) NOT NULL DEFAULT 0.00,
  `unit`        ENUM('peso','kg') NOT NULL DEFAULT 'peso' COLLATE utf8mb4_general_ci,
  `status`      ENUM('Completed','In Progress','Pending') NOT NULL DEFAULT 'Pending' COLLATE utf8mb4_general_ci,
  `record_date` DATE          NOT NULL,
  `notes`       TEXT          DEFAULT NULL COLLATE utf8mb4_general_ci,
  `created_at`  TIMESTAMP     NOT NULL DEFAULT CURRENT_TIMESTAMP,
  PRIMARY KEY (`id`),
  KEY `user_id` (`user_id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci;

