CREATE TABLE IF NOT EXISTS `notifications` (
  `id`          INT(11)      NOT NULL AUTO_INCREMENT,
  `user_id`     INT(11)      NOT NULL,
  `title`       VARCHAR(200) NOT NULL COLLATE utf8mb4_general_ci,
  `description` TEXT         DEFAULT NULL COLLATE utf8mb4_general_ci,
  `status`      ENUM('unread','read') NOT NULL DEFAULT 'unread' COLLATE utf8mb4_general_ci,
  `starred`     TINYINT(1)   NOT NULL DEFAULT 0,
  -- Extended to include 'pest' and 'water': the bell-dropdown icon function
  -- (bellNotifIcon, used on dashboard/records/reports/notifications) already
  -- had icons for these two types, but the original ENUM didn't allow them.
  `type`        ENUM('plant','weather','reminder','harvest','pest','water','system') NOT NULL DEFAULT 'system' COLLATE utf8mb4_general_ci,
  `notif_date`  DATE         DEFAULT NULL,
  `created_at`  TIMESTAMP    NOT NULL DEFAULT CURRENT_TIMESTAMP,
  PRIMARY KEY (`id`),
  KEY `user_id` (`user_id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci;

